{{ '{{' }}- if .Values.lvms.enabled }}
apiVersion: v1
kind: ConfigMap
metadata:
  name: osac-infra-lvms-config
  labels:
    {{ '{{' }}- include "osac-infra.labels" . | nindent 4 }}
  annotations:
    "helm.sh/hook": pre-install,pre-upgrade
    "helm.sh/hook-delete-policy": before-hook-creation
data:
  config.yaml: |
    apiVersion: lvm.topolvm.io/v1alpha1
    kind: LVMCluster
    metadata:
      name: lvms-cluster
      namespace: openshift-lvm-storage
    spec:
      storage:
        deviceClasses:
          - name: vg1
            default: true
            deviceSelector:
              paths:
{{ ocp4_workload_osac_lvms_disks | to_nice_yaml | indent(16, True) }}            thinPoolConfig:
              name: thin-pool-1
              sizePercent: 90
              overprovisionRatio: 10
{{ '{{' }}- end }}
