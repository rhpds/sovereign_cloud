# {{ ansible_managed }}
# OSAC Demo Platform — VMaaS + CaaS

certManager:
  enabled: true
trustManager:
  enabled: true
caIssuer:
  enabled: true
keycloak:
  enabled: true
aapOperator:
  enabled: true
lvms:
  enabled: false
metallb:
  enabled: true
cnv:
  enabled: true
mce:
  enabled: true
  osImages:
  - openshiftVersion: "{{ ocp4_workload_osac_openshift_version }}"
    version: "{{ ocp4_workload_osac_rhcos_version }}"
    url: >-
      https://mirror.openshift.com/pub/openshift-v4/x86_64/dependencies/rhcos/{{ ocp4_workload_osac_openshift_version }}/{{ ocp4_workload_osac_openshift_version }}.0/rhcos-{{ ocp4_workload_osac_openshift_version }}.0-x86_64-live-iso.x86_64.iso
    cpuArchitecture: "x86_64"

operator:
  image:
    repository: "{{ ocp4_workload_osac_operator_image | regex_replace(':.*$', '') }}"
    tag: "{{ ocp4_workload_osac_operator_image | regex_replace('^.*:', '') }}"
    pullPolicy: Always
  provisioning:
    provider: "aap"
  aap:
    url: ""
    insecureSkipVerify: "true"
    statusPollInterval: "30s"
    templatePrefix: "osac"
  fulfillment:
    serverAddress: "fulfillment-internal-api:8001"
    tokenFile: "/var/run/secrets/kubernetes.io/serviceaccount/token"
  controllers:
    clusterOrder: true
    computeInstance: true
    tenant: true
    networking: true
    storage: true

service:
  variant: openshift
  externalHostname: "fulfillment-api-{{ ocp4_workload_osac_namespace }}.{{ openshift_cluster_ingress_domain }}"
  internalHostname: "fulfillment-internal-api-{{ ocp4_workload_osac_namespace }}.{{ openshift_cluster_ingress_domain }}"
  images:
    service: "{{ ocp4_workload_osac_fulfillment_service_image }}"
    envoy: "{{ ocp4_workload_osac_envoy_image }}"
  certs:
    issuerRef:
      kind: ClusterIssuer
      name: default-ca
    caBundle:
      configMap: ca-bundle
  auth:
    issuerUrl: https://keycloak.keycloak.svc.cluster.local/realms/osac
    emergencyServiceAccounts:
    - admin
    - osac-operator
    - osac-operator-controller-manager
    - template-publisher
    controllerCredentials:
    - secret:
        name: fulfillment-controller-credentials
        items:
        - key: client-id
          param: client-id
        - key: client-secret
          param: client-secret
  idp:
    provider: keycloak
    url: https://keycloak.keycloak.svc.cluster.local
    credentials:
    - secret:
        name: fulfillment-controller-credentials
        items:
        - key: client-id
          param: client-id
        - key: client-secret
          param: client-secret
  database:
    connection:
    - secret:
        name: fulfillment-db
        items:
        - key: url
          param: url
    - secret:
        name: postgres-client-cert-service
        items:
        - key: tls.crt
          param: sslcert
        - key: tls.key
          param: sslkey
        - key: ca.crt
          param: sslrootcert
  log:
    level: info

ui:
  enabled: true
  images:
    ui: "{{ ocp4_workload_osac_ui_image }}"
  api:
    fulfillment:
      certs:
        caBundle:
          configMap: ca-bundle
  auth:
    certs:
      caBundle:
        configMap: ca-bundle

aap:
  aap:
    instance:
      enabled: true
      name: osac-aap
  bootstrap:
    enabled: true
    image: "{{ ocp4_workload_osac_aap_bootstrap_image }}"
    backoffLimit: 15
  instanceGroups:
    clusterFulfillment:
      enabled: true
      config:
        NETWORK_CLASS: "esi"
        NETWORK_STEPS_COLLECTION: "osac.steps"
        EXTERNAL_ACCESS_BASE_DOMAIN: "box.massopen.cloud"
        EXTERNAL_ACCESS_SUPPORTED_BASE_DOMAINS: "box.massopen.cloud"
        EXTERNAL_ACCESS_API_INTERNAL_NETWORK: "hypershift"
        HOSTED_CLUSTER_BASE_DOMAIN: "box.massopen.cloud"
        HOSTED_CLUSTER_CONTROLLER_AVAILABILITY_POLICY: "HighlyAvailable"
        HOSTED_CLUSTER_INFRASTRUCTURE_AVAILABILITY_POLICY: "HighlyAvailable"
    networkFulfillment:
      enabled: true
      config:
        NETRIS_CONTROLLER_URL: "https://redhat-ctl.netris.io"
        NETRIS_USERNAME: "netris"
        NETRIS_SITE_ID: "5"
        NETRIS_TENANT_ID: "1"
        NETRIS_TENANT_NAME: "Admin"

validation:
  enabled: true

# Required on demo labs unless an external Postgres + fulfillment-db secret exist
bundledPostgres:
  enabled: true
  database:
    name: service
    user: service

hubAccess:
  enabled: true

# BMaaS off unless Ironic/inventory secrets are provisioned (blocks Helm --wait otherwise)
bmf:
  enabled: false

clusterVersions:
  enabled: false
  versions:
{% for cv in ocp4_workload_osac_cluster_versions %}
  - version: "{{ cv.version }}"
    image: "{{ cv.image }}"
{% if cv.default | default(false) %}
    default: true
{% endif %}
{% endfor %}
